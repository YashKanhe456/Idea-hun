# MongoDB connection string
# Required. Points to your MongoDB instance.
# Local development: mongodb://localhost:27017
# With authentication: mongodb://username:password@host:port/database
MONGO_URL=mongodb://localhost:27017

# Database name
# Required. The MongoDB database used by the application.
DB_NAME=idea_hub

# CORS allowed origins
# Required. Comma-separated list of origins allowed to call the API.
# Must include your frontend URL(s).
# Local development: http://localhost:3000
# Multiple origins: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000
